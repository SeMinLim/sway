    "reconstruction_assumptions": {
      "convolution": "Causal depthwise width 4 with bias, followed by SiLU, as in standard Mamba; eMamba does not specify the kernel or grouping and its figure omits conv SiLU.",
      "delta": "Rank ceil(D/16)=2; ReLU after both projections to keep delta nonnegative. Figure 3 places Softplus between projections; exact ordering is unresolved.",
      "head": "Flatten the 16 tokens, linear 320->20, ReLU, linear 20->57. The regression head is not published; this explicit assumption preserves patch positions.",
      "biases": "No in/out/x projection biases; convolution and delta projection biases enabled, as in standard Mamba; embedding and regression biases enabled.",
      "initialization": "Kaiming-uniform linear/conv; A=-exp(A_log), A initialized to -1..-8; D=1; positive log-uniform delta biases 0.01..0.1 for ReLU.",
      "normalization": "Per-token range across D channels, learnable per-channel gamma and beta; denominator clamped to epsilon for constant inputs.",
      "state_reset": "Zero convolution history and zero selective state independently for each 8x8x5 radar frame.",
      "pwl": "Own secant coefficients at 18 SiLU knots and 12 exponential knots; 17 and 11 segments match the stated counts, but author coefficients and their error definition are unpublished.",
      "parameter_count": "Head and other omitted details prevent exact recovery of the reported 16.8 KB INT8 parameter footprint. The actual count is measured and reported separately."
    }
  },
